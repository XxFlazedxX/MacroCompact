                    "\nRegion: " .. (location.region or "Unknown") .. 
                    "\nCountry: " .. (location.country or "Unknown") .. 
                    "\nISP: " .. (location.isp or "Unknown") .. 
                    "\nTimezone: " .. (location.timezone or "Unknown") .. "```",
